FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    innerWall
    {
        type            rotatingWallVelocity;
        origin          (|-ecc-| 0 0);
        axis            (0 0 1);
        omega           |-omega-|;
    }
    outerWall
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}

