FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// Steady: one time step is one iteration. The run stops before
// maxIterations once the residualControl limits in fvSolution are met.
endTime         |-maxIterations-|;

deltaT          1;

writeControl    timeStep;

writeInterval   |-writeInterval-|;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    // Initial residuals per time step, for python -m cfdtools.monitor.
    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (U p);
    }

    // Torque on the bob about the z axis, side and bottom face separately.
    // The mesh is a wedge of |-angle_deg-| degrees: multiply by
    // |-wedge_to_full-| (parameter wedge_to_full) for the full device.
    rotorSideTorque
    {
        type            forces;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   10;
        patches         (rotorSide);
        rho             rhoInf;
        rhoInf          |-rho_kg_m3-|;
        CofR            (0 0 0);
    }

    rotorBottomTorque
    {
        type            forces;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   10;
        patches         ("rotorBottom");    // regex: matches nothing when Hb = 0
        rho             rhoInf;
        rhoInf          |-rho_kg_m3-|;
        CofR            (0 0 0);
    }

    // Wall shear stress on the bob, written as a field (wallShearStress) with
    // every saved time. Kinematic (m^2/s^2): multiply by rho = |-rho_kg_m3-|
    // for Pa.
    bobWallShear
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         (rotorSide "rotorBottom");
        writeControl    writeTime;
        log             false;
    }
}

