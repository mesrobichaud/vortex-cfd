FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.1;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors    1;
    consistent                  yes;    // SIMPLEC

    // Stop before maxIterations once the initial residuals fall below these.
    residualControl
    {
        p                       1e-6;
        U                       1e-6;
    }

    // Closed domain: no patch fixes the pressure level.
    pRefCell                    0;
    pRefValue                   0;
}

// SIMPLEC (consistent yes): pressure is not relaxed.
relaxationFactors
{
    equations
    {
        U                       0.9;
        ".*"                    0.9;
    }
}

