FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    // Bob: side and bottom face, rotating about the z axis.
    "(rotorSide|rotorBottom)"
    {
        type            rotatingWallVelocity;
        origin          (0 0 0);
        axis            (0 0 1);
        omega           |-omega-|;
    }

    // Cup: stationary.
    "(cupWall|cupBottom)"
    {
        type            noSlip;
    }

    // Fluid surface, modelled as flat and free of shear.
    top
    {
        type            slip;
    }

    "(front|back)"
    {
        type            wedge;
    }
}

