FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Kinematic pressure, p/rho.
dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "(rotorSide|rotorBottom|cupWall|cupBottom|top)"
    {
        type            zeroGradient;
    }

    "(front|back)"
    {
        type            wedge;
    }
}

