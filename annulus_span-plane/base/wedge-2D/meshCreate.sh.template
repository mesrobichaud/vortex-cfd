#!/bin/sh
# Mesh step, run by pyFoamPrepareCase.py from the case directory.
# gmsh (geometry/wedge.py) -> MSH 2 -> gmshToFoam -> patch types.
set -e

# Find the mesh builders: the first geometry/ folder in this directory or a
# parent directory (currently CFD/geometry/).
root=$(pwd)
while [ ! -d "$root/geometry" ]; do
    [ "$root" = / ] && { echo "no geometry/ directory above $(pwd)" >&2; exit 1; }
    root=$(dirname "$root")
done

python "$root/geometry/wedge.py" -o wedge.msh \
    --Ri |-Ri-| --Ro |-Ro-| --height |-H-| --bottom-gap |-Hb-| \
    --angle |-angle_deg-| --edge-radius |-edge_radius-| --bottom-angle |-bottom_angle_deg-| \
    --nr-gap |-nr_gap-| --nr-core |-nr_core-| --nz-ann |-nz_ann-| --nz-bot |-nz_bot-| \
    --bump-r |-bump_r-| --bump-z |-bump_z-|

gmshToFoam wedge.msh

# gmshToFoam writes every patch as type 'patch'. The two wedge planes must be
# type 'wedge' for OpenFOAM to treat the case as axisymmetric.
pyFoamChangeBoundaryType.py . front wedge
pyFoamChangeBoundaryType.py . back wedge
pyFoamChangeBoundaryType.py . rotorSide wall
pyFoamChangeBoundaryType.py . cupWall wall
pyFoamChangeBoundaryType.py . cupBottom wall

# rotorBottom only exists when there is a bottom gap (Hb_mm > 0).
if grep -q "^ *rotorBottom$" constant/polyMesh/boundary; then
    pyFoamChangeBoundaryType.py . rotorBottom wall
fi

checkMesh
